# Copiar a .env.local para cambiar el comportamiento en desarrollo

# Qué se publica (ver src/app/scope.ts). En Netlify lo fija netlify.toml.
#   full     → todo: los tres roles y las solicitudes (por defecto)
#   cliente  → landing + app del cliente, sin solicitar servicios
#   landing  → solo la landing
VITE_DEMO_SCOPE=full
